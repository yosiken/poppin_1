[sub_resource type="Resource" id="Resource_xga3v"]
script = ExtResource("1_bkhll")
speaker = "ルイ"
text = "丸い球体って言い方やめてよ！ でも、ソースとマヨネーズの香ばしい匂いが鼻をくすぐる……。あ！ たこ焼きだ！ 外はカリッと、中はトロ〜ッとしてて、大ぶりのタコが入ってて……あそこのたこ焼きが一番美味しいんだよね！"
speaking = 2
right = ExtResource("2_d3whh")

[sub_resource type="Resource" id="Resource_uoqmy"]
script = ExtResource("1_bkhll")
text = "えーっと、店名は……『わなか』！"
speaking = 2

[sub_resource type="Resource" id="Resource_pdpm5"]
script = ExtResource("1_bkhll")
speaker = "シマエナガ"
text = "正解だ。たこ焼道楽『わなか』。やはりビールに合わせるならこれに限る。お前の味覚の記憶だけは、脳味噌のキャパシティの割にしっかりしているな。次だ、3枚目のカードをめくれ"
speaking = 1
left = ExtResource("3_uga3f")

[resource]
script = ExtResource("4_qxl11")
lines = Array[ExtResource("1_bkhll")]([SubResource("Resource_xga3v"), SubResource("Resource_uoqmy"), SubResource("Resource_pdpm5")])
