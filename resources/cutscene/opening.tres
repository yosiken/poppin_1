[ext_resource type="Script" uid="uid://bqyr8gw275yuu" path="res://scripts/cutscene_line.gd" id="1_yji8q"]
[ext_resource type="Texture2D" uid="uid://bapvuydl2abwd" path="res://resources/texture/OB_a.png" id="2_2ssu3"]
[ext_resource type="Texture2D" uid="uid://d1plbi1v65put" path="res://resources/texture/kanie_a.png" id="3_tlocn"]
[ext_resource type="Script" uid="uid://chyw4up7w6ec2" path="res://scripts/cutscene_data.gd" id="4_crtyr"]

[sub_resource type="Resource" id="Resource_yji8q"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "いやぁ……今日もいい配信だった……。もうお酒は控えよう……明日から……"
speaking = 2
right = ExtResource("2_2ssu3")
note = "演出：深夜
演出：ゲーム配信を終え、すっかり泥酔したOBは、ふらふらしながら自宅へ帰ってきた"

[sub_resource type="Resource" id="Resource_2ssu3"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……あっ、ビールある"
speaking = 2
note = "演出：そう言いながら冷蔵庫を開ける"

[sub_resource type="Resource" id="Resource_tlocn"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……おいしい"
speaking = 2
note = "演出：プシュッ"

[sub_resource type="Resource" id="Resource_crtyr"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "いったぁぁぁぁぁぁぁ！！"
speaking = 2
note = "演出：結局、もう一杯飲んでしまう
演出：その後、寝室へ向かおうとしたOBだったが――
演出：ゴンッ！"

[sub_resource type="Resource" id="Resource_xrrmf"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……ん……？　ここ……どこ？"
speaking = 2
note = "演出：タンスの角に小指を直撃
演出：その瞬間、視界が真っ白になる
演出：気がつくと、OBは見知らぬ世界に立っていた
演出：石畳の広場。見上げるほど高い塔
演出：空には巨大な月が浮かび、看板には見たことのない文字
演出：そして何より――"

[sub_resource type="Resource" id="Resource_yime8"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "やっと起きたか。何時間寝とんねん"
speaking = 1
left = ExtResource("3_tlocn")

[sub_resource type="Resource" id="Resource_v46gj"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……え？"
speaking = 2

[sub_resource type="Resource" id="Resource_nviov"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "ワイや、ワイ。いつも肩に乗っとるやろ"
speaking = 1

[sub_resource type="Resource" id="Resource_mgmiw"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……カニエナガ？"
speaking = 2

[sub_resource type="Resource" id="Resource_yd60s"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "そうや"
speaking = 1

[sub_resource type="Resource" id="Resource_xkdfa"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……しゃべった？"
speaking = 2

[sub_resource type="Resource" id="Resource_1jbvs"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "そらしゃべるわ"
speaking = 1

[sub_resource type="Resource" id="Resource_n1ewt"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "いや、現実ではしゃべってなかったよね？"
speaking = 2

[sub_resource type="Resource" id="Resource_jiib1"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "今は異世界やからな"
speaking = 1

[sub_resource type="Resource" id="Resource_oowkn"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "異世界……？"
speaking = 2

[sub_resource type="Resource" id="Resource_hm1xt"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "昨日、泥酔して帰ってきて、タンスの角に小指ぶつけたやろ"
speaking = 1

[sub_resource type="Resource" id="Resource_212ne"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "…………"
speaking = 2

[sub_resource type="Resource" id="Resource_rci5l"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "そのショックでここに転生したんや"
speaking = 1

[sub_resource type="Resource" id="Resource_4asgv"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "そんなことある？"
speaking = 2

[sub_resource type="Resource" id="Resource_fwxhe"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "あるんやから仕方ないやろ"
speaking = 1

[sub_resource type="Resource" id="Resource_juxf4"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "じゃあ、どうすれば帰れるの？"
speaking = 2

[sub_resource type="Resource" id="Resource_63rlw"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "お前が現実で食ったり飲んだり、愛用したりしてた『大事なもの』を10個集めるんや"
speaking = 1

[sub_resource type="Resource" id="Resource_1lrai"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "10個……？"
speaking = 2

[sub_resource type="Resource" id="Resource_ikt8q"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "全部思い出したら、現世へのゲートが開くんや"
speaking = 1

[sub_resource type="Resource" id="Resource_fx44p"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……でも私、何を食べたか全然覚えてないんだけど"
speaking = 2

[sub_resource type="Resource" id="Resource_105or"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "そら泥酔しとったからな"
speaking = 1

[sub_resource type="Resource" id="Resource_jf354"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "じゃあ、どうやって探すの？"
speaking = 2

[sub_resource type="Resource" id="Resource_8r17r"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "ワイがヒントを出したる。ただし、中身は言わん"
speaking = 1

[sub_resource type="Resource" id="Resource_fdyrt"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "えっ、なんで？"
speaking = 2

[sub_resource type="Resource" id="Resource_vfmkv"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "答え聞いてから思い出すんは、思い出したうちに入らんやろ"
speaking = 1

[sub_resource type="Resource" id="Resource_1h462"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "…………正論"
speaking = 2

[sub_resource type="Resource" id="Resource_uwg6m"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "心配せんでも、見たらお前の本能が思い出すわ"
speaking = 1

[sub_resource type="Resource" id="Resource_88qxy"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "本能？"
speaking = 2

[sub_resource type="Resource" id="Resource_q2dq3"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "酒とカニと金に関してだけは、記憶力ええからな"
speaking = 1

[sub_resource type="Resource" id="Resource_8qr0o"]
script = ExtResource("1_yji8q")
speaker = "OB"
text = "……なんか失礼じゃない？"
speaking = 2

[sub_resource type="Resource" id="Resource_3ubda"]
script = ExtResource("1_yji8q")
speaker = "カニエナガ"
text = "ほな行くで"
speaking = 1

