[sub_resource type="Resource" id="Resource_oqwq2"]
script = ExtResource("1_ygqeh")
speaker = "シマエナガ"
text = "……思い出すまでもないな。当たり前すぎてクイズの体をなしていない。だが、これで最初のピースは埋まった。次に行くぞ"
speaking = 1
left = ExtResource("3_1ilod")

