[sub_resource type="Resource" id="Resource_hbbsx"]
script = ExtResource("1_ygqeh")
speaker = "ルイ"
text = "な、失礼な！ でも……うん、入店して席に着いた瞬間、喉がカラカラで……。あ、思い出した！『とりあえず生で！』"
