   },
   {
    "speaker": "カニエナガ",
    "text": "やっと起きた？　何時間寝てるんだよ",
    "side": "left",
    "show_left": true
   },
   {
    "speaker": "OB",
    "text": "……え？",
    "side": "right"
   },
   {
