   },
   {
    "speaker": "OB",
    "text": "10個……？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "全部思い出したら、現世へのゲートが開くよ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "……でも私、何を食べたか全然覚えてないんだけど",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "そら泥酔しとったからな",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "じゃあ、どうやって探すの？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "ボクがヒントを出してあげる。ただし、答えは言わないよ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "えっ、なんで？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "答えを聞いてから思い出しても、思い出したうちに入らないでしょ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "…………正論",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "心配しなくても、見たらOBの本能が思い出すよ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "本能？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "酒とカニと金に関してだけは、記憶力ええからな",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "……なんか失礼じゃない？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "それじゃ、行くで！",
    "side": "left"
   }
  ]
 },
