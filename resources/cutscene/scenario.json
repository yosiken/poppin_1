{
 "opening": {
  "title": "プロローグ：OP",
  "notes": [
   "演出：深夜",
   "演出：ゲーム配信を終え、すっかり泥酔したOBは、ふらふらしながら自宅へ帰ってきた",
   "演出：そう言いながら冷蔵庫を開ける",
   "演出：プシュッ",
   "演出：結局、もう一杯飲んでしまう",
   "演出：その後、寝室へ向かおうとしたOBだったが――",
   "演出：ゴンッ！",
   "演出：タンスの角に小指を直撃",
   "演出：その瞬間、視界が真っ白になる",
   "演出：気がつくと、OBは見知らぬ世界に立っていた",
   "演出：石畳の広場。見上げるほど高い塔",
   "演出：空には巨大な月が浮かび、看板には見たことのない文字",
   "演出：そして何より――"
  ],
  "rows": [
   {
    "speaker": "OB",
    "text": "いやぁ……今日もいい配信だった……。もうお酒は控えよう……明日から……",
    "side": "right",
    "show_right": true,
    "note": "演出：深夜\n演出：ゲーム配信を終え、すっかり泥酔したOBは、ふらふらしながら自宅へ帰ってきた"
   },
   {
    "speaker": "OB",
    "text": "……あっ、ビールある",
    "side": "right",
    "note": "演出：そう言いながら冷蔵庫を開ける"
   },
   {
    "speaker": "OB",
    "text": "……おいしい",
    "side": "right",
    "note": "演出：プシュッ"
   },
   {
    "speaker": "OB",
    "text": "いったぁぁぁぁぁぁぁ！！",
    "side": "right",
    "note": "演出：結局、もう一杯飲んでしまう\n演出：その後、寝室へ向かおうとしたOBだったが――\n演出：ゴンッ！"
   },
   {
    "speaker": "OB",
    "text": "……ん……？　ここ……どこ？",
    "side": "right",
    "note": "演出：タンスの角に小指を直撃\n演出：その瞬間、視界が真っ白になる\n演出：気がつくと、OBは見知らぬ世界に立っていた\n演出：石畳の広場。見上げるほど高い塔\n演出：空には巨大な月が浮かび、看板には見たことのない文字\n演出：そして何より――"
   },
   {
    "speaker": "カニエナガ",
    "text": "やっと起きたか。何時間寝とんねん",
    "side": "left",
    "show_left": true
   },
   {
    "speaker": "OB",
    "text": "……え？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "ワイや、ワイ。いつも肩に乗っとるやろ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "……カニエナガ？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "そうや",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "……しゃべった？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "そらしゃべるわ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "いや、現実ではしゃべってなかったよね？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "今は異世界やからな",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "異世界……？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "昨日、泥酔して帰ってきて、タンスの角に小指ぶつけたやろ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "…………",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "そのショックでここに転生したんや",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "そんなことある？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "あるんやから仕方ないやろ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "じゃあ、どうすれば帰れるの？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "お前が現実で食ったり飲んだり、愛用したりしてた『大事なもの』を10個集めるんや",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "10個……？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "全部思い出したら、現世へのゲートが開くんや",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "……でも私、何を食べたか全然覚えてないんだけど",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "そら泥酔しとったからな",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "じゃあ、どうやって探すの？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "ワイがヒントを出したる。ただし、中身は言わん",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "えっ、なんで？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "答え聞いてから思い出すんは、思い出したうちに入らんやろ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "…………正論",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "心配せんでも、見たらお前の本能が思い出すわ",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "本能？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "酒とカニと金に関してだけは、記憶力ええからな",
    "side": "left"
   },
   {
    "speaker": "OB",
    "text": "……なんか失礼じゃない？",
    "side": "right"
   },
   {
    "speaker": "カニエナガ",
    "text": "ほな行くで",
    "side": "left"
   }
  ]
 },
