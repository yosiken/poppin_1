shader_type canvas_item;
//
// ミラータイリング。1マスごとに絵を反転して貼る。
//
// 隣り合うマスが必ず鏡写しになるので、上下左右が繋がっていない絵でも
// 継ぎ目が出ない。素材がシームレスに作られていないときの逃げ道。
//
// 代わりに対称の模様が出る。芝や土のような細かい絵なら気づかれないが、
// レンガや板のように向きのある絵に使うと不自然になる。
//
// UV は Polygon2D が 0〜1 を超えて渡してくる（繰り返しの回数ぶん）。
// それを 0→1→0 の三角波に変えることで折り返している。
//

void fragment() {
	vec2 mirrored = abs(fract(UV * 0.5) * 2.0 - 1.0);
	COLOR = texture(TEXTURE, mirrored) * COLOR;
}
