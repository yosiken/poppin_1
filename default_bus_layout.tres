room_size = 0.25
damping = 0.6
spread = 0.6
hipass = 0.3
wet = 0.12

[sub_resource type="AudioEffectHardLimiter" id="voice_limiter"]
resource_name = "HardLimiter"
ceiling_db = -1.0

[resource]
