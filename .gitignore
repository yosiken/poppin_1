# Godot が生成するもの（再生成されるのでコミットしない）
.godot/

# 書き出したビルド成果物
build/

# Blender が自動で作るバックアップ
*.blend1

# Claude Codeの個人環境専用設定（各自のPCごとに異なるため共有しない）
.claude/settings.local.json

# Mixamo から持ってきたモーション。素材単体での再配布は規約上できないので、
# リポジトリには含めず各自の手元に置く。
# 無い状態でも起動はする（タイトルとゴールでモーションが再生されないだけ）
resources/model/Northern Soul Spin.fbx
resources/model/Northern Soul Spin.fbx.import
resources/model/Twist Dance.fbx
resources/model/Twist Dance.fbx.import

# Effekseer の、このプロジェクトが書き出さないプラットフォーム向けバイナリ。
# Windows と Web しか出さないので、残り(iOS 124MB / Android 11MB / Linux 9.7MB /
# macOS 2.6MB)はリポジトリに入れない。gitの履歴は後から消せないため。
# 必要になったらここの行を消してコミットすること（アドオンの配布物に入っている）
addons/effekseer/bin/ios/
addons/effekseer/bin/android/
addons/effekseer/bin/linux/
addons/effekseer/bin/macos/

# Godot がGDExtensionのDLLを差し替える際に残す一時ファイル
*.TMP
~*
